# OLOCRON engage API — production environment.
#
# Copy this file to .env (in the repo root, next to docker-compose.yml)
# and fill in the values. The .env is read by docker compose; it is NOT
# baked into the Docker image.
#
#   cp deploy/.env.production.example .env
#   # edit .env, then:
#   docker compose up -d --build

# ── Database ──────────────────────────────────────────────────────────────────
# A strong password for the Postgres `olon` user. Generate one:
#   python -c "import secrets; print(secrets.token_urlsafe(24))"
# This is used BOTH as the Postgres superuser password AND in the DATABASE_URL
# the app connects with. The compose stack wires them together automatically.
POSTGRES_PASSWORD=__GENERATE_A_STRONG_PASSWORD__

# ── LLM provider (required — the engine calls Z.ai / GLM for deliberations) ───
# Your Z.ai API key. Get one at https://z.ai/  (this is the same key used
# locally in the olon .env).
ZAI_API_KEY=__YOUR_ZAI_API_KEY__

# Optional provider overrides (leave as defaults unless you've customised):
# ZAI_BASE_URL=https://api.z.ai/api/anthropic

# ── Governance tuning (optional — sensible defaults) ─────────────────────────
# Comma-separated model ids the gateway may use (cheapest first).
# HARNESS_MODELS=GLM-5-Turbo
# Per-run cost cap in USD before the engine aborts (safety brake).
# HARNESS_COST_CAP_USD=5.0

# ── Governance tokens ─────────────────────────────────────────────────────────
# Founder bearer token for the attest endpoint (S9). REQUIRED in production —
# empty disables attestation entirely. Generate:
#   python -c "import secrets; print(secrets.token_urlsafe(32))"
HARNESS_FOUNDER_TOKEN=__GENERATE_FOUNDER_TOKEN__
# Chief Governance Agent token (G1): bounded delegated attestation + digest
# builds. Optional — empty disables CGA auth (founder token still works).
# Generate the same way; MUST differ from the founder token.
HARNESS_CGA_TOKEN=
