# ───────────────────────────────────────────────────────────────
# OLOCRON — environment template
# Copy to .env and fill in. NEVER commit the real .env.
# ───────────────────────────────────────────────────────────────

# --- LLM provider (primary: Z.ai / GLM, Anthropic-compatible) ---
# The gateway targets Z.ai first; add others to enable the federation layer (S7).
ZAI_API_KEY=
ZAI_BASE_URL=https://api.z.ai/api/anthropic

# Optional secondary providers (leave blank for now):
OPENAI_API_KEY=
ANTHROPIC_API_KEY=

# --- Harness runtime ---
# Comma-separated model IDs the gateway may route to (cheap + expensive tiers).
# Z.ai models (Anthropic-compatible interface):
HARNESS_MODELS=GLM-5.2,GLM-5-Turbo
# Per-run cost cap in USD before the run aborts.
HARNESS_COST_CAP_USD=5
# Port for the local harness API.
HARNESS_PORT=8787

# --- Governance tokens ---
# S9: founder bearer token for attestation (empty = endpoint disabled).
# Generate: python -c "import secrets; print(secrets.token_urlsafe(32))"
HARNESS_FOUNDER_TOKEN=
# G1: Chief Governance Agent bearer token — bounded delegated attestation +
# digest builds (empty = CGA auth disabled; founder token still works).
# Generate the same way. MUST differ from HARNESS_FOUNDER_TOKEN.
HARNESS_CGA_TOKEN=

# --- Postgres (immutable ledger + agent registry) ---
# Native install: PostgreSQL 17 on localhost:5432, database `olon`.
DATABASE_URL=postgresql://postgres:CHANGE_ME@localhost:5432/olon
