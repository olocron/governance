# Caddy reverse proxy for the OLOCRON engage API.
#
# Caddy automatically provisions and renews Let's Encrypt TLS certificates
# for api.kimberim.com and api.olocron.org (requires each domain's DNS
# A-record to point at this server and ports 80+443 reachable).
#
# api.olocron.org is the forward address (olocron.org not yet registered at
# time of staging): until its A-record exists, Caddy will log ACME issuance
# failures for that name and retry with backoff — harmless to the live
# kimberim.com site. Once DNS points here, TLS + proxying start working
# with no further config change.
#
# No manual cert management needed — this is the whole HTTPS config.

{
	# Global server options: generous timeouts for long SSE deliberation
	# streams (up to ~30 min) and slow clients.
	servers {
		timeouts {
			read_body 30s
			read_header 10s
			write 0s
			idle 30m
		}
	}
}

api.kimberim.com, api.olocron.org {
	# Stream immediately (flush_interval -1) — SSE deliberation events on
	# /deliberations/{run_id}/events must reach the client unbuffered.
	# No `encode` (compression): gzip would buffer event streams.
	reverse_proxy api:8787 {
		flush_interval -1
	}

	# Security headers.
	header {
		Strict-Transport-Security "max-age=31536000"
		X-Content-Type-Options "nosniff"
		Referrer-Policy "strict-origin-when-cross-origin"
	}

	# Access + error logs.
	log {
		output stdout
		format console
	}
}
